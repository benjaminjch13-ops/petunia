# ---------- Servidor (Express) ----------
# Puerto de la API REST
PORT=4000
# Origen permitido por CORS (URL del frontend en desarrollo)
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Fuente de datos del catálogo: "local" (archivos en server/data).
# Preparado para añadir otras fuentes (p. ej. "mongo", "postgres") en server/services/repositories.
DATA_SOURCE=local

# ---------- Cliente (Vite + React) ----------
# URL base de la API que usa el navegador. En desarrollo se deja "/api" y Vite la redirige al servidor.
VITE_API_URL=/api
# Destino del proxy de Vite en desarrollo (debe coincidir con PORT del servidor)
API_PROXY_TARGET=http://127.0.0.1:4000
